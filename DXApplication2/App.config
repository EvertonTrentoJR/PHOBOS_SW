      </setting>
      <setting name="StartFreq" serializeAs="String">
        <value>40</value>
      </setting>
      <setting name="EndFreq" serializeAs="String">
        <value>1000000</value>
      </setting>
      <setting name="NPoints" serializeAs="String">
        <value>201</value>
      </setting>
      <setting name="Log" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="SamplingTime" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="NSamples" serializeAs="String">
        <value>3</value>
      </setting>
      <setting name="Filename" serializeAs="String">
        <value>LCR_meter_test_xx</value>
      </setting>
      <setting name="Path" serializeAs="String">
        <value />
